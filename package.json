{
  "name": "dsh-compact",
  "version": "1.1.0",
  "description": "DeepSeek Harness 上下文自动压缩、手动压缩与溢出恢复插件",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "context-compaction"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zixin947/dsh-compact.git"
  },
  "homepage": "https://github.com/zixin947/dsh-compact#readme",
  "bugs": {
    "url": "https://github.com/zixin947/dsh-compact/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./agent": "./lib/agent.js",
    "./engine": "./lib/engine.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "dsh": "^0.2.1-rc.2"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    },
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-command-compact": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-command-compact": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "license": "MIT"
}
